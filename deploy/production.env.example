# Template for the VM's ~/rental-review/.env. CI replaces each ${...} with the value
# from the GitHub/GitLab "production" environment; everything else is used as is.
# The database is the shared PostgreSQL (../postgres-platform); its credentials are
# generated on the VM by ensure-db, so nothing database-related is set here.
APP_ENV=production
# At least 32 random characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`.
SECRET_KEY=${SECRET_KEY}
# Google OAuth "Web application" client id; https://rentalreview.boringman.in must be
# an authorized JavaScript origin.
GOOGLE_CLIENT_IDS=${GOOGLE_CLIENT_IDS}
# Optional. Map and search provider: "google", "here", "mapbox", "ola" or "osm" (free
# OpenStreetMap). Empty: Google when GOOGLE_MAPS_API_KEY is set, otherwise OpenStreetMap.
# The chosen provider's key below is required; restrict each key to the site's domain.
MAP_PROVIDER=${MAP_PROVIDER}
# Optional. Google Maps browser key (Maps JavaScript API + Places API (New)), restricted
# to the https://rentalreview.boringman.in referrer, and a vector Map ID. Without the
# key the map shows as unavailable and the property list still works.
GOOGLE_MAPS_API_KEY=${GOOGLE_MAPS_API_KEY}
GOOGLE_MAPS_MAP_ID=${GOOGLE_MAPS_MAP_ID}
HERE_API_KEY=${HERE_API_KEY}
MAPBOX_ACCESS_TOKEN=${MAPBOX_ACCESS_TOKEN}
OLA_MAPS_API_KEY=${OLA_MAPS_API_KEY}
# Optional ads. ADS_PROVIDER=adsense needs ADSENSE_CLIENT (ca-pub-…); each placement
# shows an ad only when its ad unit id is set. Empty: no ads, no ad script.
ADS_PROVIDER=${ADS_PROVIDER}
ADSENSE_CLIENT=${ADSENSE_CLIENT}
ADSENSE_SLOT_HOME=${ADSENSE_SLOT_HOME}
ADSENSE_SLOT_LIST=${ADSENSE_SLOT_LIST}
ADSENSE_SLOT_PLACE=${ADSENSE_SLOT_PLACE}
SEED_DEMO_DATA=false
BACKEND_MEMORY_LIMIT=384m
WEB_MEMORY_LIMIT=128m
