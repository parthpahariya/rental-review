# Copy to .env before starting. The database (shared PostgreSQL) needs nothing here:
# `make db` generates its credentials in ../postgres-platform/credentials/.
WEB_PORT=8080
API_PORT=8000
APP_ENV=development
SECRET_KEY=local-development-only-change-before-deployment
SEED_DEMO_DATA=true
BACKEND_MEMORY_LIMIT=384m
WEB_MEMORY_LIMIT=128m
# Google sign-in (the only way to sign in): OAuth "Web application" client id from
# Google Cloud Console (APIs & Services > Credentials). Add every site origin, e.g.
# http://localhost:8080, under "Authorized JavaScript origins". Required in production.
GOOGLE_CLIENT_IDS=
